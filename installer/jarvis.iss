; JARVIS — Windows installer (Inno Setup 6)
;
; Per-user install: no admin prompt. Everything lands in
; %LOCALAPPDATA%\Programs\JARVIS and the uninstaller reverses it,
; including the virtualenv it builds.
;
; The file list is NOT written here. `build.ps1` generates files.iss
; from `git ls-files`, so the installer can only ever ship files that
; are tracked in the repository. That is deliberate: .env, logs/,
; voices/*.onnx, memory/*.db, docs/research/ and the other personal
; paths are all gitignored, so they cannot be packaged by accident —
; a mistake here would leak API keys. See installer/README.md.
;
; Build:  powershell -File installer\build.ps1

#define MyAppName "JARVIS"
#define MyAppPublisher "Youssef Development"
#define MyAppURL "https://youssef-devolopment.github.io/jarvis/"
#ifndef MyAppVersion
  #define MyAppVersion "0.0.0"
#endif

[Setup]
; A stable AppId keeps upgrades working across versions — never change it.
AppId={{8E2C4A1F-6B7D-4F3A-9C5E-1D2A3B4C5D6E}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
VersionInfoVersion={#MyAppVersion}
VersionInfoDescription={#MyAppName} {#MyAppVersion} Setup
DefaultDirName={localappdata}\Programs\JARVIS
DefaultGroupName=JARVIS
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=..\dist
OutputBaseFilename=JARVIS-Setup-{#MyAppVersion}
SetupIconFile=jarvis.ico
UninstallDisplayIcon={app}\installer\jarvis.ico
UninstallDisplayName={#MyAppName} {#MyAppVersion}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
LicenseFile=..\LICENSE
AllowNoIcons=yes
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "deps"; Description: "Set up the Python environment now (downloads dependencies; needs internet)"; GroupDescription: "Setup:"
Name: "playwright"; Description: "Include the browser engine for browsing skills (~150 MB; needs the line above)"; GroupDescription: "Setup:"
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "Options:"; Flags: unchecked
Name: "autostart"; Description: "Start JARVIS automatically when I sign in"; GroupDescription: "Options:"; Flags: unchecked

[Files]
; The installer's own files ship explicitly. build.ps1 generates the
; app's file list from git and skips this folder, so nothing here is
; packaged twice.
Source: "jarvis.ico"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "install-deps.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "build.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "jarvis.iss"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "README.md"; DestDir: "{app}\installer"; Flags: ignoreversion

; Generated by build.ps1 from `git ls-files` — one Source line per tracked file.
#include "files.iss"

[Icons]
Name: "{autoprograms}\JARVIS"; Filename: "{app}\.venv\Scripts\pythonw.exe"; Parameters: """{app}\desktop.py"""; WorkingDir: "{app}"; IconFilename: "{app}\installer\jarvis.ico"; Comment: "Start JARVIS (tray + Alt+Space HUD)"
Name: "{autoprograms}\JARVIS (console)"; Filename: "{app}\.venv\Scripts\python.exe"; Parameters: """{app}\run.py"""; WorkingDir: "{app}"; IconFilename: "{app}\installer\jarvis.ico"; Comment: "Start JARVIS with a console window, so logs are visible"
Name: "{autoprograms}\Uninstall JARVIS"; Filename: "{uninstallexe}"
Name: "{autodesktop}\JARVIS"; Filename: "{app}\.venv\Scripts\pythonw.exe"; Parameters: """{app}\desktop.py"""; WorkingDir: "{app}"; IconFilename: "{app}\installer\jarvis.ico"; Tasks: desktopicon

[Registry]
; Autostart is a per-user Run key, so it needs no admin rights and no
; scheduled task. The uninstaller removes it again.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "JARVIS"; ValueData: """{app}\.venv\Scripts\pythonw.exe"" ""{app}\desktop.py"""; Flags: uninsdeletevalue; Tasks: autostart

[Run]
; Offered on the finish page, and only when the environment was built.
Filename: "{app}\.venv\Scripts\pythonw.exe"; Parameters: "{app}\desktop.py"; WorkingDir: "{app}"; Description: "Launch JARVIS now"; Flags: nowait postinstall skipifsilent; Tasks: deps

[UninstallDelete]
; Things the app generates AFTER install, which Inno would otherwise
; leave behind. `memory\` is deliberately absent: it holds the user's
; own memory database, and an uninstaller must not silently delete
; user data.
Type: filesandordirs; Name: "{app}\.venv"
Type: filesandordirs; Name: "{app}\logs"
Type: filesandordirs; Name: "{app}\.browser_profile"
Type: filesandordirs; Name: "{app}\.headless_profile"
Type: filesandordirs; Name: "{app}\.voice_cache"
Type: filesandordirs; Name: "{app}\jarvis_data"
Type: filesandordirs; Name: "{app}\skills_backup_*"
Type: files; Name: "{app}\.env"

[Code]
function RunHidden(const Cmd: String): Integer;
var
  R: Integer;
begin
  if Exec('cmd.exe', '/c ' + Cmd, '', SW_HIDE, ewWaitUntilTerminated, R) then
    Result := R
  else
    Result := -1;
end;

function PythonFound(): Boolean;
begin
  Result := (RunHidden('py -3.10 -V >nul 2>&1') = 0)
         or (RunHidden('py -3 -V >nul 2>&1') = 0)
         or (RunHidden('python -V >nul 2>&1') = 0);
end;

function NodeFound(): Boolean;
begin
  Result := RunHidden('node --version >nul 2>&1') = 0;
end;

{ Every dependency is optional at install time, but building the
  environment is not possible without Python, and MCP servers need
  Node. Warn with a way forward instead of failing later. }
function NextButtonClick(CurPageID: Integer): Boolean;
var
  Missing: String;
begin
  Result := True;
  if CurPageID <> wpReady then
    Exit;

  Missing := '';
  if WizardIsTaskSelected('deps') and (not PythonFound()) then
    Missing := Missing + '- Python 3.10 or newer was not found. JARVIS needs it to run:'
      + #13#10 + '  https://www.python.org/downloads/' + #13#10 + #13#10;
  if not NodeFound() then
    Missing := Missing + '- Node.js was not found. JARVIS itself runs without it, but MCP servers need it:'
      + #13#10 + '  https://nodejs.org/' + #13#10 + #13#10;

  if Missing = '' then
    Exit;

  if SuppressibleMsgBox('Some optional prerequisites are missing:' + #13#10 + #13#10 + Missing
      + 'Continue anyway? (You can install them later and re-run the environment setup '
      + 'with installer\install-deps.ps1.)', mbConfirmation, MB_YESNO, IDYES) = IDNO then
    Result := False;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Script, LogPath, Params: String;
  ResultCode: Integer;
begin
  if (CurStep <> ssPostInstall) or (not WizardIsTaskSelected('deps')) then
    Exit;

  Script := ExpandConstant('{app}\installer\install-deps.ps1');
  LogPath := ExpandConstant('{app}\logs\install.log');
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + Script + '" -AppDir "'
            + ExpandConstant('{app}') + '"';
  if not WizardIsTaskSelected('playwright') then
    Params := Params + ' -SkipPlaywright';

  { SW_SHOW on purpose: pip output is the honest progress bar, and a
    silent multi-minute download looks like a hang. }
  if not Exec('powershell.exe', Params, ExpandConstant('{app}'), SW_SHOW,
              ewWaitUntilTerminated, ResultCode) then
  begin
    { Suppressible so an unattended (/SILENT) install can never hang here. }
    SuppressibleMsgBox('Could not start PowerShell to build the Python environment.'
      + #13#10 + 'Run installer\install-deps.ps1 from the install folder to '
      + 'finish setup.', mbError, MB_OK, IDOK);
    Exit;
  end;

  if ResultCode <> 0 then
    SuppressibleMsgBox('JARVIS is installed, but the Python environment could not be built '
      + '(exit code ' + IntToStr(ResultCode) + ').' + #13#10 + #13#10
      + 'The log is here:' + #13#10 + LogPath + #13#10 + #13#10
      + 'Fix whatever it reports, then run that script again from the install '
      + 'folder — nothing needs to be reinstalled.', mbError, MB_OK, IDOK)
  else
    SuppressibleMsgBox('JARVIS is installed and its Python environment is ready.'
      + #13#10 + #13#10 + 'It runs without any API key: 142 local skills work '
      + 'immediately. Add a key to .env any time to turn on the AI layer.'
      + #13#10 + #13#10 + 'The dashboard is at http://127.0.0.1:5000 unless you '
      + 'change PORT in .env.', mbInformation, MB_OK, IDOK);
end;
